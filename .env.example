SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DEMO_PASSWORD=change-this-demo-password
# --- Correo: código de recuperación de contraseña ---
# Desarrollo: imprime el correo en la terminal, no envía nada.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Producción con Amazon SES (ver GUIA_AWS_SES.md):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=credencial-SMTP-de-SES
# EMAIL_HOST_PASSWORD=contraseña-SMTP-de-SES
# DEFAULT_FROM_EMAIL=no-reply@tu-dominio.cl
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_TIMEOUT=10
CODIGO_DURACION_MINUTOS=15

# Para MySQL en AWS, usar por ejemplo:
# DEBUG=False
# ALLOWED_HOSTS=IP_PUBLICA_EC2
